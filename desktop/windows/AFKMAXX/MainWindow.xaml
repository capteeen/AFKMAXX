<Window x:Class="AFKMAXX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AFKMAXX"
        Width="1080" Height="700"
        MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#0B0D12">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F4F1E8"/>
    </Style>
    <Style x:Key="Glass" TargetType="Border">
      <Setter Property="Background" Value="#2EFFFFFF"/>
      <Setter Property="BorderBrush" Value="#55FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="22"/>
      <Setter Property="Padding" Value="24"/>
    </Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="268"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{StaticResource Glass}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,28">
          <TextBlock Text="AFKMAXX" FontSize="24" FontWeight="Black" DockPanel.Dock="Left"/>
          <TextBlock x:Name="ModeLabel" Text="DESKTOP" FontSize="10" Foreground="#A7AAA4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="ON THIS PC" FontSize="10" Foreground="#A7AAA4" Margin="0,0,0,8"/>
        <TextBlock x:Name="SideStatus" DockPanel.Dock="Top" Text="PAUSED" FontSize="28" FontWeight="Black" Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top" Text="Nothing runs until you start." FontSize="13" Foreground="#A7AAA4" TextWrapping="Wrap" x:Name="SideHint"/>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#A7AAA4" Text="In return for AFKMAXX desktop features you may choose to be a peer on the Bright Data network. Pause or disable Web Indexing anytime."/>
          <TextBlock Margin="0,12,0,0" FontSize="10">
            <Hyperlink NavigateUri="https://bright-sdk.com/eula" RequestNavigate="OnLink">Bright EULA</Hyperlink>
            <Run Text="   "/>
            <Hyperlink NavigateUri="https://bright-sdk.com/privacy-policy" RequestNavigate="OnLink">SDK privacy</Hyperlink>
          </TextBlock>
        </StackPanel>
        <StackPanel VerticalAlignment="Bottom" Margin="0,24,0,16">
          <TextBlock Text="Web Indexing" FontSize="14" Margin="0,0,0,6"/>
          <DockPanel>
            <CheckBox x:Name="IndexToggle" DockPanel.Dock="Right" VerticalAlignment="Center" Checked="OnIndexOn" Unchecked="OnIndexOff"/>
            <TextBlock x:Name="IndexHint" Text="Enable to keep AFKMAXX desktop checks available." FontSize="12" Foreground="#A7AAA4" TextWrapping="Wrap"/>
          </DockPanel>
          <Button Content="Open dashboard  ↗" Click="OnDashboard" Background="#C8FF3D" Foreground="#0B0D12" BorderThickness="0" Padding="14,10" Margin="0,16,0,0" Cursor="Hand"/>
          <TextBlock Margin="0,12,0,0">
            <Hyperlink NavigateUri="https://bright-sdk.com/users#learn-more-about-bright-sdk-web-indexing" RequestNavigate="OnLink">Learn more</Hyperlink>
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource Glass}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Width="220">
            <Border Background="#22FFFFFF" CornerRadius="99" Padding="10,8" HorizontalAlignment="Right" Margin="0,0,0,12">
              <TextBlock x:Name="Chip" Text="PAUSED" FontSize="10" Foreground="#A7AAA4" HorizontalAlignment="Center"/>
            </Border>
            <Button x:Name="PauseButton" Content="Start side quest  ↗" Click="OnPause" Background="#C8FF3D" Foreground="#0B0D12" BorderThickness="0" Padding="16,12" Cursor="Hand"/>
            <Button Content="Open dashboard  ↗" Click="OnDashboard" Background="#22FFFFFF" Foreground="#F4F1E8" BorderBrush="#55FFFFFF" BorderThickness="1" Padding="16,12" Margin="0,10,0,0" Cursor="Hand"/>
          </StackPanel>
          <StackPanel>
            <TextBlock x:Name="Eyebrow" Text="YOUR CONNECTION IS TAKING A BREATHER" FontSize="10" Foreground="#C8FF3D" Margin="0,0,0,8"/>
            <DockPanel>
              <TextBlock x:Name="StatusWord" Text="PAUSED" FontSize="52" FontWeight="Black" DockPanel.Dock="Left"/>
              <TextBlock x:Name="StatusMark" Text="Ⅱ" FontSize="28" Foreground="#C8FF3D" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,24,0"/>
            </DockPanel>
            <TextBlock x:Name="StatusNote" TextWrapping="Wrap" FontSize="13" Foreground="#A7AAA4" Margin="0,8,24,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource Glass}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="LIMITS" FontSize="10" Foreground="#A7AAA4" Margin="0,0,0,12"/>
          <TextBlock x:Name="SdkNote" DockPanel.Dock="Bottom" FontSize="12" Foreground="#A7AAA4" TextWrapping="Wrap"/>
          <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#A7AAA4" Text="Set Web Indexing in the sidebar. This window is a desktop console, not a phone panel. Pause anytime from here or the menu bar."/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
