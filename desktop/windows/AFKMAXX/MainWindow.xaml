<Window x:Class="AFKMAXX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AFKMAXX"
        Width="380" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B0D12">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F4F1E8"/>
    </Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="AFKMAXX" FontSize="22" FontWeight="Black" DockPanel.Dock="Left"/>
      <TextBlock Text="DESKTOP" FontSize="10" Foreground="#A7AAA4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </DockPanel>

    <StackPanel Grid.Row="1">
      <Rectangle Height="1" Fill="#34373B" Margin="0,0,0,22"/>
      <TextBlock x:Name="Eyebrow" Text="YOUR CONNECTION IS TAKING A BREATHER" FontSize="10" Foreground="#A7AAA4" Margin="0,0,0,8"/>
      <DockPanel>
        <TextBlock x:Name="StatusWord" Text="PAUSED" FontSize="48" FontWeight="Black" DockPanel.Dock="Left"/>
        <TextBlock x:Name="StatusMark" Text="Ⅱ" FontSize="32" Foreground="#C8FF3D" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock x:Name="StatusNote" TextWrapping="Wrap" FontSize="13" Foreground="#A7AAA4" Margin="0,8,0,16"/>
      <Button x:Name="PauseButton" Content="Start side quest  ↗" Click="OnPause" Background="#C8FF3D" Foreground="#0B0D12" BorderThickness="0" Padding="16,12" Cursor="Hand"/>
      <Rectangle Height="1" Fill="#34373B" Margin="0,22,0,18"/>
      <TextBlock Text="LIMITS" FontSize="10" Foreground="#A7AAA4" Margin="0,0,0,12"/>
      <DockPanel>
        <StackPanel>
          <TextBlock Text="Web Indexing" FontSize="14"/>
          <TextBlock x:Name="IndexHint" Text="Enable to keep AFKMAXX desktop checks available." FontSize="12" Foreground="#A7AAA4" TextWrapping="Wrap" Width="250"/>
        </StackPanel>
        <CheckBox x:Name="IndexToggle" DockPanel.Dock="Right" VerticalAlignment="Center" Checked="OnIndexOn" Unchecked="OnIndexOff"/>
      </DockPanel>
      <TextBlock Margin="0,12,0,0">
        <Hyperlink NavigateUri="https://bright-sdk.com/users#learn-more-about-bright-sdk-web-indexing" RequestNavigate="OnLink">Learn more</Hyperlink>
      </TextBlock>
      <TextBlock x:Name="SdkNote" FontSize="12" Foreground="#A7AAA4" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>

    <StackPanel Grid.Row="3">
      <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#A7AAA4" Text="In return for AFKMAXX desktop features you may choose to be a peer on the Bright Data network. Pause or disable Web Indexing anytime."/>
      <TextBlock Margin="0,10,0,0" FontSize="10">
        <Hyperlink NavigateUri="https://bright-sdk.com/eula" RequestNavigate="OnLink">Bright EULA</Hyperlink>
        <Run Text="   "/>
        <Hyperlink NavigateUri="https://bright-sdk.com/privacy-policy" RequestNavigate="OnLink">SDK privacy</Hyperlink>
      </TextBlock>
    </StackPanel>
  </Grid>
</Window>
