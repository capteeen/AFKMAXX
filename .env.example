# SQLite for local. Production: postgresql://user:pass@host:5432/afkmaxx
# and change prisma/schema.prisma datasource provider to postgresql.
DATABASE_URL="file:./dev.db"

# Public origin for email-confirm redirects.
AUTH_URL="http://127.0.0.1:4173"

# Supabase Auth (Project Settings → API).
# Use the publishable key (sb_publishable_…) or legacy anon JWT (eyJ…).
# NEVER use sb_secret_ or the service_role key — those are server-only and will be blocked.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# First account with this email is promoted to admin on login.
ADMIN_EMAIL="you@example.com"
