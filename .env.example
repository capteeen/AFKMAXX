# SQLite for local. Production: postgresql://user:pass@host:5432/afkmaxx
# and change prisma/schema.prisma datasource provider to postgresql.
DATABASE_URL="file:./dev.db"

# Public origin for email-confirm redirects.
AUTH_URL="http://127.0.0.1:4173"

# Supabase Auth (Project Settings → API).
# Use the publishable key (sb_publishable_…) or legacy anon JWT (eyJ…).
# NEVER use sb_secret_ or the service_role key — those are server-only and will be blocked.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# First account with this email is promoted to admin on login.
ADMIN_EMAIL="you@example.com"

# Clerk (Dashboard → API keys). Never put CLERK_SECRET_KEY in client code.
# Set both on Vercel or every page 500s. Production publishable keys start with pk_live_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_DISABLE_AUTO_PROXY="true"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/app"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/app"
